# Copy to backend/.env and fill in.

# Free model (the default). Get a free Gemini key, no credit card needed:
# https://aistudio.google.com/apikey
ASKDB_FREE_API_KEY=

# Claude (optional). Pick "Claude" in the UI, or set ASKDB_PROVIDER=claude.
ANTHROPIC_API_KEY=

# Which model answers by default: free (default), claude, local (open model via
# Ollama), or auto (Claude when ANTHROPIC_API_KEY is set, otherwise free).
# The UI can switch per question either way.
# ASKDB_PROVIDER=free

# Free model settings. Any OpenAI-compatible chat API works; defaults are Gemini.
# ASKDB_FREE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ASKDB_FREE_MODEL=gemini-flash-latest   # list options: uv run askdb --list-models
# ASKDB_FREE_TIMEOUT_S=120
#
# Other free options (set all three):
#   Groq:       ASKDB_FREE_BASE_URL=https://api.groq.com/openai/v1   ASKDB_FREE_MODEL=openai/gpt-oss-120b
#   OpenRouter: ASKDB_FREE_BASE_URL=https://openrouter.ai/api/v1     ASKDB_FREE_MODEL=<a model ending in :free>
#   LM Studio:  ASKDB_FREE_BASE_URL=http://localhost:1234/v1         ASKDB_FREE_MODEL=<loaded model>

# Open model settings (used when provider=local).
# ASKDB_LOCAL_MODEL=hf.co/mradermacher/Arctic-Text2SQL-R1-7B-GGUF:Q4_K_M
# ASKDB_LOCAL_BASE_URL=http://localhost:11434
# ASKDB_LOCAL_API=ollama          # or "openai" for vLLM / llama.cpp / LM Studio /v1/completions
# ASKDB_LOCAL_TIMEOUT_S=600

# Uploaded databases. Turn off on a public server: there are no user accounts,
# so everyone sees every upload.
# ASKDB_ALLOW_UPLOADS=true
# ASKDB_MAX_UPLOAD_MB=50
# ASKDB_MAX_UPLOADS=20

# Optional overrides (defaults shown).
# ASKDB_DATABASE_URL=sqlite:///data/chinook.sqlite
# ASKDB_MODEL=claude-opus-5-5
# ASKDB_EFFORT=medium
# ASKDB_MAX_RETRIES=2
# ASKDB_ROW_LIMIT=100
# ASKDB_STATEMENT_TIMEOUT_S=10
# ASKDB_REFERENCE_DATE=2013-12-31
# ASKDB_CORS_ORIGINS=["http://localhost:3000"]
