# Copy to backend/.env and fill in.
ANTHROPIC_API_KEY=

# Which model answers by default: claude, or local (open model via Ollama).
# The UI can switch per question either way.
# ASKDB_PROVIDER=claude

# Open model settings (used when provider=local).
# ASKDB_LOCAL_MODEL=hf.co/mradermacher/Arctic-Text2SQL-R1-7B-GGUF:Q4_K_M
# ASKDB_LOCAL_BASE_URL=http://localhost:11434
# ASKDB_LOCAL_API=ollama          # or "openai" for vLLM / llama.cpp / LM Studio /v1/completions
# ASKDB_LOCAL_TIMEOUT_S=600

# Optional overrides (defaults shown).
# ASKDB_DATABASE_URL=sqlite:///data/chinook.sqlite
# ASKDB_MODEL=claude-opus-5-5
# ASKDB_EFFORT=medium
# ASKDB_MAX_RETRIES=2
# ASKDB_ROW_LIMIT=100
# ASKDB_STATEMENT_TIMEOUT_S=10
# ASKDB_REFERENCE_DATE=2013-12-31
# ASKDB_CORS_ORIGINS=["http://localhost:3000"]
