# Copy to backend/.env and fill in. Everything here is optional.

# Server-side model keys. Optional: users can paste their own key in the app
# (key button in the top bar), which is kept in their browser and takes
# precedence. On a public deployment a server key is spent by every visitor.

# Free model (the default). Get a free Gemini key, no credit card needed:
# https://aistudio.google.com/apikey
ASKDB_FREE_API_KEY=

# Claude (optional). Pick "Claude" in the UI, or set ASKDB_PROVIDER=claude.
ANTHROPIC_API_KEY=

# Which provider answers by default: free (default), claude, groq, openrouter,
# openai, local (open model via Ollama), or auto (Claude when ANTHROPIC_API_KEY is
# set, otherwise free). The UI can switch provider and model per question.
# ASKDB_PROVIDER=free

# More providers. Each takes a server key, a default model, and the models
# visitors may pick on that key (users with their own key can pick any model).
# ASKDB_GROQ_API_KEY=
# ASKDB_GROQ_MODEL=openai/gpt-oss-120b
# ASKDB_GROQ_MODELS=["openai/gpt-oss-120b"]
# ASKDB_OPENROUTER_API_KEY=
# ASKDB_OPENROUTER_MODEL=openrouter/auto
# ASKDB_OPENAI_API_KEY=
# ASKDB_OPENAI_MODEL=gpt-5-mini

# Claude models visitors may pick on the server's key (default: Opus, Sonnet,
# Haiku; Fable 5.1 costs 2.5x Opus, so it's only offered with a user's own key).
# ASKDB_CLAUDE_MODELS=["claude-opus-5-5","claude-sonnet-5-5","claude-haiku-4-5"]

# Free model settings. Any OpenAI-compatible chat API works; defaults are Gemini.
# ASKDB_FREE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ASKDB_FREE_MODEL=gemini-flash-latest   # list options: uv run askdb --list-models
# ASKDB_FREE_TIMEOUT_S=120
#
# Another OpenAI-compatible service as the free provider (Groq, OpenRouter and
# OpenAI have their own settings above):
#   LM Studio:  ASKDB_FREE_BASE_URL=http://localhost:1234/v1   ASKDB_FREE_MODEL=<loaded model>

# Open model settings (used when provider=local).
# ASKDB_LOCAL_MODEL=hf.co/mradermacher/Arctic-Text2SQL-R1-7B-GGUF:Q4_K_M
# ASKDB_LOCAL_BASE_URL=http://localhost:11434
# ASKDB_LOCAL_API=ollama          # or "openai" for vLLM / llama.cpp / LM Studio /v1/completions
# ASKDB_LOCAL_TIMEOUT_S=600

# Uploaded databases. Each upload is private to the browser that made it (a
# random id in localStorage, not an account).
# ASKDB_ALLOW_UPLOADS=true
# ASKDB_MAX_UPLOAD_MB=50
# ASKDB_MAX_UPLOADS=20          # per browser
# ASKDB_MAX_TOTAL_UPLOADS=200   # across everyone

# Optional overrides (defaults shown).
# ASKDB_DATABASE_URL=sqlite:///data/chinook.sqlite
# ASKDB_MODEL=claude-opus-5-5
# ASKDB_EFFORT=medium
# ASKDB_MAX_RETRIES=2
# ASKDB_ROW_LIMIT=100
# ASKDB_STATEMENT_TIMEOUT_S=10
# ASKDB_REFERENCE_DATE=2013-12-31
# ASKDB_CORS_ORIGINS=["http://localhost:3000"]
